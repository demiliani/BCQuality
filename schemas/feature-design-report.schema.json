{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/microsoft/BCQuality/schemas/feature-design-report.schema.json",
  "title": "BCQuality feature-design report (experimental)",
  "description": "A knowledge-grounded design for a Business Central feature request, produced before any code exists. Every design element cites the BCQuality articles it is based on; facts the request does not settle are open questions, never defaults.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill",
    "outcome",
    "summary",
    "context",
    "design",
    "knowledge",
    "open-questions",
    "suppressed",
    "unresolved"
  ],
  "properties": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "outcome": {
      "enum": [
        "completed",
        "not-applicable",
        "no-knowledge",
        "partial",
        "failed"
      ]
    },
    "outcome-reason": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "business-process",
        "candidates",
        "selected"
      ],
      "properties": {
        "request": {
          "type": "string",
          "minLength": 1
        },
        "business-process": {
          "type": "string",
          "minLength": 1
        },
        "candidates": {
          "type": "integer",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bc-version",
        "technologies",
        "countries",
        "application-area",
        "unknown"
      ],
      "properties": {
        "bc-version": {
          "type": "string",
          "minLength": 1
        },
        "technologies": {
          "$ref": "#/definitions/stringArray"
        },
        "countries": {
          "$ref": "#/definitions/stringArray"
        },
        "application-area": {
          "$ref": "#/definitions/stringArray"
        },
        "unknown": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "bc-version",
              "technologies",
              "countries",
              "application-area"
            ]
          }
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objects",
        "data-flow",
        "subscriptions",
        "lifecycle",
        "tests"
      ],
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "action",
              "object-type",
              "target",
              "purpose",
              "knowledge"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/slug"
              },
              "action": {
                "enum": [
                  "create",
                  "extend",
                  "modify"
                ]
              },
              "object-type": {
                "enum": [
                  "table",
                  "tableextension",
                  "page",
                  "pageextension",
                  "codeunit",
                  "report",
                  "reportextension",
                  "query",
                  "xmlport",
                  "enum",
                  "enumextension",
                  "interface",
                  "permissionset",
                  "permissionsetextension"
                ]
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "type"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "knowledge": {
                "$ref": "#/definitions/pathArray"
              }
            }
          }
        },
        "data-flow": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "mechanism",
              "knowledge"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "mechanism": {
                "enum": [
                  "transferfields",
                  "event-copy",
                  "validate",
                  "user-entry",
                  "other"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              },
              "knowledge": {
                "$ref": "#/definitions/pathArray"
              }
            }
          }
        },
        "subscriptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "publisher",
              "event",
              "purpose",
              "knowledge"
            ],
            "properties": {
              "publisher": {
                "type": "string",
                "minLength": 1
              },
              "event": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "guards": {
                "$ref": "#/definitions/stringArray"
              },
              "knowledge": {
                "$ref": "#/definitions/pathArray"
              }
            }
          }
        },
        "lifecycle": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "concern",
              "step",
              "knowledge"
            ],
            "properties": {
              "concern": {
                "enum": [
                  "install",
                  "upgrade",
                  "setup",
                  "permissions",
                  "privacy",
                  "telemetry",
                  "background",
                  "other"
                ]
              },
              "step": {
                "type": "string",
                "minLength": 1
              },
              "knowledge": {
                "$ref": "#/definitions/pathArray"
              }
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "given",
              "when",
              "then",
              "knowledge"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/slug"
              },
              "given": {
                "type": "string",
                "minLength": 1
              },
              "when": {
                "type": "string",
                "minLength": 1
              },
              "then": {
                "type": "string",
                "minLength": 1
              },
              "knowledge": {
                "$ref": "#/definitions/pathArray"
              }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "app",
              "reason"
            ],
            "properties": {
              "app": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f-]{36}$"
              },
              "publisher": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "knowledge": {
                "$ref": "#/definitions/pathArray"
              }
            }
          }
        }
      }
    },
    "knowledge": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "used-for",
          "constraints"
        ],
        "properties": {
          "path": {
            "$ref": "#/definitions/knowledgePath"
          },
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$"
          },
          "used-for": {
            "type": "string",
            "minLength": 1
          },
          "constraints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sample-paths": {
            "$ref": "#/definitions/stringArray"
          }
        }
      }
    },
    "open-questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "affects"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/slug"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "affects": {
            "$ref": "#/definitions/stringArray"
          }
        }
      }
    },
    "suppressed": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "$ref": "#/definitions/knowledgePath"
          },
          "reason": {
            "enum": [
              "layer-precedence",
              "configuration"
            ]
          }
        }
      }
    },
    "unresolved": {
      "$ref": "#/definitions/stringArray"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "partial",
              "failed",
              "not-applicable"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "outcome-reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "completed"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "knowledge": {
            "minItems": 1
          },
          "design": {
            "properties": {
              "objects": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "not-applicable",
              "no-knowledge",
              "failed"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "knowledge": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "definitions": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "knowledgePath": {
      "type": "string",
      "pattern": "^(microsoft|community|custom)/knowledge/[a-z0-9-]+/[a-z0-9-]+\\.md$"
    },
    "pathArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/knowledgePath"
      }
    }
  }
}
